{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "rankings-editorial",
 "title": "leagues/<league>/editorial/rankings/<season>_weekNN.json: what the commissioner writes for a ranked week (decision 7.9)",
 "type": "object",
 "required": [
  "season",
  "week",
  "teams"
 ],
 "additionalProperties": false,
 "properties": {
  "season": {
   "type": "integer"
  },
  "week": {
   "type": "integer",
   "minimum": 1
  },
  "status": {
   "enum": [
    "draft",
    "published"
   ],
   "description": "draft: not on the site yet (engine rankings start/new write drafts); published or absent: shown"
  },
  "label": {
   "type": "string"
  },
  "blurb_label": {
   "type": "string"
  },
  "hide_archetype_link": {
   "type": "boolean"
  },
  "teams": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "required": [
     "manager",
     "rank"
    ],
    "additionalProperties": false,
    "properties": {
     "manager": {
      "type": "string",
      "minLength": 1
     },
     "rank": {
      "type": "integer",
      "minimum": 1
     },
     "synopsis": {
      "type": "string"
     },
     "blurb": {
      "type": "string"
     },
     "screenshots": {
      "type": "array"
     }
    }
   }
  },
  "matchup_of_the_week": {
   "type": "object",
   "required": [
    "team_a",
    "team_b"
   ],
   "properties": {
    "team_a": {
     "type": "string"
    },
    "team_b": {
     "type": "string"
    },
    "blurb": {
     "type": "string"
    }
   }
  }
 }
}
