{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "rankings-snapshot",
 "title": "leagues/<league>/snapshots/rankings/<season>_weekNN.json: a ranked week's computed fields, frozen when published (decision 7.9)",
 "type": "object",
 "required": [
  "season",
  "week"
 ],
 "properties": {
  "season": {
   "type": "integer"
  },
  "week": {
   "type": "integer"
  },
  "teams": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "manager"
    ],
    "properties": {
     "manager": {
      "type": "string"
     },
     "proj_ppg": {
      "type": [
       "number",
       "null"
      ]
     },
     "proj_ppg_ros": {
      "type": [
       "number",
       "null"
      ]
     },
     "sos_avg_opp_ppg": {
      "type": [
       "number",
       "null"
      ]
     },
     "sos_rank": {
      "type": [
       "integer",
       "null"
      ]
     },
     "draft_grade": {
      "type": [
       "number",
       "null"
      ]
     },
     "draft_surplus_total": {
      "type": [
       "number",
       "null"
      ]
     },
     "draft_picks": {
      "type": "array",
      "items": {
       "type": "object",
       "required": [
        "player",
        "pos",
        "round",
        "pick_in_round",
        "overall"
       ],
       "properties": {
        "player": {
         "type": [
          "string",
          "null"
         ]
        },
        "nfl_team": {
         "type": [
          "string",
          "null"
         ]
        },
        "pos": {
         "type": [
          "string",
          "null"
         ]
        },
        "round": {
         "type": "integer"
        },
        "pick_in_round": {
         "type": "integer"
        },
        "overall": {
         "type": "integer"
        },
        "espn_adp": {
         "type": [
          "number",
          "null"
         ]
        },
        "adp_deviation": {
         "type": [
          "number",
          "null"
         ]
        },
        "grade": {},
        "surplus_value": {
         "type": [
          "number",
          "null"
         ]
        }
       }
      }
     },
     "adp_value": {
      "type": [
       "number",
       "null"
      ]
     },
     "position_spend": {
      "type": [
       "object",
       "null"
      ],
      "additionalProperties": {
       "type": "number"
      }
     },
     "draft_archetype": {
      "type": [
       "object",
       "null"
      ],
      "required": [
       "cluster_id",
       "name",
       "confidence",
       "comparisons"
      ],
      "properties": {
       "cluster_id": {
        "type": "integer"
       },
       "name": {
        "type": [
         "string",
         "null"
        ]
       },
       "confidence": {
        "type": "string"
       },
       "comparisons": {
        "type": "array",
        "items": {
         "type": "object",
         "required": [
          "manager",
          "season"
         ],
         "properties": {
          "manager": {
           "type": "string"
          },
          "season": {
           "type": "integer"
          },
          "archetype": {
           "type": [
            "string",
            "null"
           ]
          },
          "ppg": {
           "type": [
            "number",
            "null"
           ]
          },
          "dist": {
           "type": [
            "number",
            "null"
           ]
          }
         }
        }
       },
       "dist_to_nearest": {
        "type": [
         "number",
         "null"
        ]
       },
       "margin_over_2nd": {
        "type": [
         "number",
         "null"
        ]
       }
      }
     }
    }
   }
  },
  "lineups": {
   "type": "object",
   "additionalProperties": {
    "type": "object",
    "properties": {
     "proj_total": {
      "type": [
       "number",
       "null"
      ]
     },
     "starters": {
      "type": "array",
      "items": {
       "type": "object",
       "required": [
        "player",
        "pos",
        "slot"
       ],
       "properties": {
        "player": {
         "type": [
          "string",
          "null"
         ]
        },
        "nfl_team": {
         "type": [
          "string",
          "null"
         ]
        },
        "pos": {
         "type": [
          "string",
          "null"
         ]
        },
        "slot": {
         "type": "string"
        },
        "opp": {
         "type": [
          "string",
          "null"
         ]
        },
        "proj": {
         "type": [
          "number",
          "null"
         ]
        }
       }
      }
     }
    }
   }
  },
  "player_season_totals": {
   "type": "object",
   "additionalProperties": {
    "type": [
     "number",
     "null"
    ]
   }
  },
  "undrafted_players": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "player",
     "pos"
    ],
    "properties": {
     "player": {
      "type": "string"
     },
     "pos": {
      "type": "string"
     },
     "nfl_team": {
      "type": [
       "string",
       "null"
      ]
     },
     "manager": {
      "type": "string"
     }
    }
   }
  }
 }
}
