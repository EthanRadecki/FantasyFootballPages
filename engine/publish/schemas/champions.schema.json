{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "champions",
  "title": "data/v1/champions.json: each finished season's champion, record, playoff run and starters (champions.html)",
  "type": "object",
  "required": [
    "meta",
    "seasons"
  ],
  "additionalProperties": false,
  "$defs": {
    "key": {
      "type": "string",
      "pattern": "^m_[0-9a-f]{12}$"
    }
  },
  "properties": {
    "meta": {
      "type": "object",
      "required": [
        "schema",
        "schema_version"
      ],
      "properties": {
        "schema": {
          "const": "champions"
        },
        "schema_version": {
          "const": 1
        }
      }
    },
    "seasons": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "season",
          "manager_key",
          "team_name",
          "wins",
          "losses",
          "ties",
          "pf_per_game",
          "playoff_ppg",
          "runner_up_key",
          "rounds"
        ],
        "properties": {
          "season": {
            "type": "integer"
          },
          "manager_key": {
            "$ref": "#/$defs/key"
          },
          "team_name": {
            "type": [
              "string",
              "null"
            ]
          },
          "wins": {
            "type": "integer"
          },
          "losses": {
            "type": "integer"
          },
          "ties": {
            "type": "integer"
          },
          "pf_per_game": {
            "type": "number"
          },
          "playoff_ppg": {
            "type": "number"
          },
          "runner_up_key": {
            "$ref": "#/$defs/key"
          },
          "rounds": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "label",
                "week",
                "points",
                "opponent_key",
                "opponent_points",
                "starters"
              ],
              "properties": {
                "label": {
                  "type": "string"
                },
                "week": {
                  "type": "integer"
                },
                "points": {
                  "type": "number"
                },
                "opponent_key": {
                  "$ref": "#/$defs/key"
                },
                "opponent_points": {
                  "type": "number"
                },
                "starters": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "slot",
                      "player_id",
                      "name",
                      "position",
                      "points",
                      "ppg"
                    ],
                    "properties": {
                      "slot": {
                        "type": "string"
                      },
                      "player_id": {
                        "type": "integer"
                      },
                      "name": {
                        "type": "string"
                      },
                      "position": {
                        "type": "string"
                      },
                      "points": {
                        "type": "number"
                      },
                      "ppg": {
                        "type": [
                          "number",
                          "null"
                        ]
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
